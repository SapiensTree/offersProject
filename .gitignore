# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel & cloudflare pages build outputs
.vercel
.wrangler/
cloudflare-env.d.ts

# pocketbase (local instance, databases & binaries)
pb_data/
*.db
*.db-journal
*.db-wal
pocketbase
pocketbase.exe

# typescript
*.tsbuildinfo
next-env.d.ts

# editor configuration
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sw?